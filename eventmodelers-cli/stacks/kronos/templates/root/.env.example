# Every variable here is declared and typed in src/env.ts; the app reads nothing else. An empty value is unset.
# These are the dev values for `bun run infra:up`; DATABASE_URL and KRONOSDB_HOST have no default, so the app
# does not boot without them.
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/app
# The event log and the command and query buses.
KRONOSDB_HOST=localhost
KRONOSDB_PORT=50051
KRONOSDB_CONTEXT=default
# KRONOSDB_TOKEN=
# Logs: one JSON object per line. debug | info | warn | error (default info).
LOG_LEVEL=info
# Traces and logs over OTLP/HTTP. Unset: no tracing. With `bun run telemetry:up`: http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=app
NODE_ENV=development
# The API reference at /docs. Unset: on in development only; true serves it in production too.
# API_DOCS=true
